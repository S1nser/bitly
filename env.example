# --- Telegram ---
# Токен бота, выданный @BotFather (например: 123456:AA...)
BOT_TOKEN=
# Username бота без @ (например: BIDLY_bot) — используется для ссылки-приглашения
BOT_USERNAME=BIDLY_bot
# Chat ID менеджера/группы BIDLY, куда будут падать "горячие лиды"
# Чтобы узнать свой chat id — напишите боту @userinfobot
ADMIN_CHAT_ID=

# --- Публичный адрес сайта (для Telegram-вебхука) ---
# На Railway можно не задавать — сервер сам возьмёт RAILWAY_PUBLIC_DOMAIN.
# Для локальной разработки оставьте пустым — бот запустится в режиме long polling.
PUBLIC_URL=

# Секретный путь вебхука (любая случайная строка) — защищает эндпоинт от чужих запросов
WEBHOOK_SECRET=change-me-to-a-random-string

# --- База данных ---
# Railway подставит эту переменную автоматически, если подключить плагин PostgreSQL.
# Для локального запуска можно оставить пустым — заявки будут храниться в памяти процесса.
DATABASE_URL=

# --- Админ-панель (/admin) ---
ADMIN_USER=bidly
ADMIN_PASSWORD=change-me

# --- Прочее ---
PORT=3000
